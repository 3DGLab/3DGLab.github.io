<header>
  {% comment %}
    Local override of al_folio_core. Three things differ from the theme file:
    the style block with the rules of this site, the lab logo as the brand, and the theme button with two states.
  {% endcomment %}
  <style>
    /* Light theme: the accent color is an indigo from the logo, with a contrast of 7.9 to 1 on white.
       It replaces the magenta of the theme (#b509ac). The dark theme keeps its own colors. */
    :root:not([data-theme='dark']) {
      --global-theme-color: #4338ca;
      --global-hover-color: #4338ca;
      --global-code-bg-color: color-mix(in srgb, #4338ca 5%, transparent);
    }

    /* A long page (Home, Publications) has a vertical scrollbar, so it is narrower than a short page.
       "100vw - 100%" is the width of that scrollbar, or 0 without one. This padding at the left
       balances the scrollbar at the right, so the centered content stays at the same place on all pages.
       The padding is never larger than the free space at the side of the content, so a narrow window loses no width. */
    body,
    footer.fixed-bottom {
      padding-left: clamp(0px, (100vw - {{ site.max_width }}) / 2, 100vw - 100%);
    }
    .navbar.fixed-top {
      /* 1rem is the usual padding of the navbar. */
      padding-left: calc(1rem + clamp(0px, (100vw - {{ site.max_width }}) / 2 - 1rem, 100vw - 100%));
    }

    /* An icon of assets/img/icons.svg. It takes the size and the color of the text. */
    .icon {
      flex: none;
      width: 1em;
      height: 1em;
      fill: currentColor;
    }
    #light-toggle .icon {
      font-size: 1.1rem;
    }

    /* The wordmark logo. Its file has empty space at the left side, 0.2 of the height.
       The negative margin puts the first letter on the left edge of the text. */
    .site-logo {
      width: auto;
      height: var(--logo-height);
      aspect-ratio: 672 / 200;
      margin-left: calc(var(--logo-height) * -0.2);
    }
    .navbar-brand {
      --logo-height: 1.75rem;
    }
    .post-title {
      --logo-height: 4.5rem;
    }

    /* On wide screens a dropdown takes the width of its entries and sits centered below its tab. */
    @media (min-width: 576px) {
      .navbar .navbar-nav .dropdown-menu {
        left: 50%;
        right: auto;
        width: max-content;
        min-width: 100%;
        transform: translateX(-50%);
      }
    }

    /* With a fixed footer bar, the "back to top" button sits above the bar: the height of the bar plus a gap. */
    body:has(footer.fixed-bottom) #back-to-top {
      bottom: 3.75rem;
    }

    /* Home page (_layouts/about.liquid). */
    .home-symbol {
      float: right;
      width: min(30%, 12.5rem);
      margin: 0 0 1rem 1.5rem;
    }
    .home-symbol img {
      width: 100%;
      aspect-ratio: 1;
    }
    .home-intro p a,
    .home .news a {
      font-weight: 500;
    }
    .home > h2 {
      margin-top: 2.5rem;
    }
    .home > h2 a {
      color: inherit;
    }
    .news th {
      width: 20%;
    }

    /* Student cards (_includes/students.liquid): small cards, as many in a row as the width holds.
       That is three on a wide screen and one on a phone. */
    .people-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .people-empty {
      margin-bottom: 2rem;
    }
    .person-card {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: 0.875rem 1rem 0.875rem 1.75rem;
      border: 1px solid var(--global-divider-color);
      border-radius: 0.5rem;
      background-color: var(--global-card-bg-color);
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }
    /* With the pointer on a card, its border and its shadow take the accent color. */
    .person-card:hover,
    .person-card:focus-within {
      border-color: color-mix(in srgb, var(--global-theme-color) 60%, var(--global-divider-color));
      box-shadow: 0 0.75rem 1.5rem -1rem var(--global-theme-color);
    }
    .person-photo {
      flex: none;
      width: 4.5rem;
      height: 4.5rem;
      border: 1px solid var(--global-divider-color);
      border-radius: 50%;
      object-fit: cover;
      transition: transform 0.2s ease;
    }
    /* Without a photo, the lab symbol sits in a circle of the same size. */
    .person-photo-empty {
      object-fit: contain;
      padding: 0.9rem;
      background-color: color-mix(in srgb, var(--global-text-color) 6%, transparent);
    }
    /* The card moves up and the photo grows, but not for a reader who asked the system for less motion. */
    @media (prefers-reduced-motion: no-preference) {
      .person-card:hover,
      .person-card:focus-within {
        transform: translateY(-3px);
      }
      .person-card:hover .person-photo,
      .person-card:focus-within .person-photo {
        transform: scale(1.06);
      }
    }
    .person-text {
      min-width: 0;
    }
    .person-text h3 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 400;
    }
    .person-text p {
      margin: 0;
      font-size: 0.95rem;
    }

    /* Links of a person (_includes/person_links.liquid). */
    .person-links {
      display: flex;
    }
    .person-links a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    /* Round icon buttons. The negative margin puts the first icon on the left edge of the text. */
    .person-links.buttons {
      --button: 1.5rem;
      --glyph: 0.95rem;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin: 0.25rem 0 0 calc((var(--glyph) - var(--button)) / 2);
    }
    .person-links.buttons a {
      justify-content: center;
      width: var(--button);
      height: var(--button);
      border-radius: 50%;
      font-size: var(--glyph);
      color: var(--global-text-color);
      transition:
        color 0.15s ease,
        background-color 0.15s ease;
    }
    .person-links.buttons a:hover,
    .person-links.buttons a:focus-visible {
      color: var(--global-theme-color);
      background-color: color-mix(in srgb, var(--global-theme-color) 14%, transparent);
    }
    /* A list of links with their text. */
    .person-links.labeled {
      flex-direction: column;
      gap: 0.35rem;
      margin-top: 1rem;
      font-size: 0.95rem;
    }
    .person-links.labeled .icon {
      color: var(--global-text-color-light);
    }

    /* Professor profile (_includes/professor.liquid): the photo and the links at the left, the lists at the right.
       The class names start with "pi-", because the theme has its own ".profile" class. */
    .pi-profile {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
      margin-bottom: 2rem;
    }
    .pi-profile-photo {
      display: block;
      width: 100%;
      max-width: 13rem;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 50%;
      border: 1px solid var(--global-divider-color);
    }
    .pi-profile-side h2 {
      margin: 1.25rem 0 0.25rem;
      font-size: 1.6rem;
    }
    .pi-profile-side p {
      margin: 0;
    }
    .pi-profile-side .pi-profile-affiliation {
      margin-top: 0.25rem;
      font-size: 0.95rem;
    }
    .pi-profile-main > :first-child {
      margin-top: 0;
    }
    .pi-profile-main h3 {
      margin: 2rem 0 0.75rem;
      font-size: 1.3rem;
    }
    .pi-profile-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .pi-profile-tags li {
      padding: 0.2rem 0.85rem;
      border: 1px solid var(--global-divider-color);
      border-radius: 999px;
      font-size: 0.9rem;
    }
    .pi-profile-timeline {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      row-gap: 0.45rem;
      margin: 0;
    }
    .pi-profile-timeline dt {
      font-weight: 400;
      color: var(--global-text-color-light);
    }
    .pi-profile-timeline dd {
      margin: 0;
    }

    /* Narrow screens: one column for the profile. */
    @media (max-width: 767.98px) {
      .pi-profile {
        grid-template-columns: minmax(0, 1fr);
        gap: 1.5rem;
      }
    }
  </style>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <!-- The brand is the lab logo. It shows on every page. -->
      <a class="navbar-brand" href="{{ '/' | relative_url }}">{% include logo.liquid name="lockup-inline" class="site-logo" %}</a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <!-- Home -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              Home
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Theme button with two states, light and dark. The first visit follows the preference of the system. -->
            <li class="toggle-container">
              {% assign icons = '/assets/img/icons.svg' | relative_url %}
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <svg class="icon only-dark" aria-hidden="true">
                  <use href="{{ icons }}#moon"></use>
                </svg>
                <svg class="icon only-light" aria-hidden="true">
                  <use href="{{ icons }}#sun"></use>
                </svg>
              </button>
              {% comment %} The theme script calls toggleThemeSetting on a click and has three states. This function has two. {% endcomment %}
              <script>
                toggleThemeSetting = function () {
                  setThemeSetting(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
                };
              </script>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
