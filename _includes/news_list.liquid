{% comment %}
  Shows the news items as a table, with the date and the text of each item.
  The items are in the front matter of _pages/news.md, newest first. This file keeps their order.
  Usage: {% include news_list.liquid %} or {% include news_list.liquid limit=5 %}
{% endcomment %}
{% assign news_page = site.pages | where: 'permalink', '/news/' | first %}
<div class="news">
  <div class="table-responsive">
    <table class="table table-sm table-borderless">
      {% for item in news_page.news limit: include.limit %}
        <tr>
          <th scope="row">{{ item.date }}</th>
          <td>{{ item.text | markdownify | remove: '<p>' | remove: '</p>' }}</td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
